<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Arquivo de Configuração WiX Toolset para geração do instalador MSI
  Para compilar com WiX:
    candle.exe Setup.wxs
    light.exe Setup.wixobj -out ParalegalCriadorPastas.msi
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Paralegal Suite - Criador de Pastas" Language="1046" Version="1.0.0.0" Manufacturer="Paralegal Tech" UpgradeCode="A7492C10-210B-4819-B427-89104F5E6821">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do Paralegal Criador de Pastas já está instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="ParalegalCriadorPastas" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="ParalegalCriadorPastas" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="D1024F56-29E8-410A-9B3B-8C49F3012903">
        <File Id="ParalegalCriadorPastas.exe" Source="ParalegalCriadorPastas.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="F201948D-781A-4A0B-B21C-59104A12B891">
        <Shortcut Id="DesktopShortcut" Name="Criador de Pastas Paralegal" Target="[INSTALLFOLDER]ParalegalCriadorPastas.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ParalegalTech\CriadorPastas" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

  </Product>
</Wix>
